# Environment Variables Example
# Duplicate this file to .env for local overrides.
# NOTE: Variables prefixed with VITE_ are exposed to the client bundle.
# Never store confidential private keys in client variables.

VITE_SITE_URL=https://muslimabbas.netlify.app
VITE_CONTACT_FORM_ENDPOINT=/.netlify/functions/contact
# Optional 3rd party email service credentials if configured:
# VITE_EMAIL_SERVICE_ID=
# VITE_EMAIL_TEMPLATE_ID=
# VITE_EMAIL_PUBLIC_KEY=
