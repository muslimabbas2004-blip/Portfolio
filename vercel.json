{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/contact.cjs": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/contact", "dest": "/api/contact.cjs" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
